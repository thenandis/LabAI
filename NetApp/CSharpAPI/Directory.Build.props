<!--
  Directory.Build.props
  =====================
  MSBuild imports this file into EVERY project below this folder, so shared
  compiler settings live in one place (DRY) and can't drift apart between projects.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Nullable reference types: the compiler catches most NullReferenceExceptions before runtime. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat warnings as errors, so code-quality problems block the build rather than piling up. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Built-in Roslyn analyzers (code quality, performance, security). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Deterministic builds: the same source always produces the same binary. -->
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      Analyzer rules relaxed for a sample/teaching codebase:
      CA1848 / CA1873 - LoggerMessage source generators (great for hot paths; overkill here)
      CA1062 - null checks on public args (nullable reference types already cover this)
      CA1515 - "make public types internal" (WebApplicationFactory tests need public types)
      CA1711 - type names ending in 'Collection'
      CA2007 - ConfigureAwait (ASP.NET Core has no SynchronizationContext)
      CA1716 - identifiers that clash with keywords in other .NET languages
      CA1819 - properties returning arrays (byte[] RowVersion is the EF Core convention)
      CA1305 / CA1307 / CA1309 / CA1310 / CA1304 / CA1311 - culture-specific string overloads
      CA1032 - standard exception constructors
      CA1031 - catching general Exception (done intentionally in the global handler)
      CA1812 - "class never instantiated" (DI creates these classes)
      CA1724 - type name clashes with namespace
      CA1859 - prefer concrete return types
      CA1861 - constant arrays as arguments
      CA1852 - seal internal types
      CA2227 - collection properties should be read-only (EF navigations)
      CA1000 - static members on generic types (Result<T>.Success is the idiomatic factory)
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1062;CA1515;CA1711;CA2007;CA1716;CA1819;CA1305;CA1307;CA1309;CA1310;CA1304;CA1311;CA1032;CA1031;CA1812;CA1724;CA1859;CA1861;CA1852;CA2227;CA1000;IDE0005</NoWarn>
  </PropertyGroup>
</Project>
