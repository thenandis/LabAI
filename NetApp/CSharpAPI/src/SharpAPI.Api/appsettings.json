{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "Catalog",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "InitializeOnStartup": false,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "OpenApi": {
    "Enabled": false
  }
}
